# Production settings for docker-compose.prod.yml.
# Copy to .env.production on the server and fill in every CHANGE-ME value:
#   cp .env.production.example .env.production
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Public domain; its DNS A record must point to this server.
DOMAIN=events.alexandrupaloti.com

# false: the stack's own Caddy takes ports 80/443 and gets the HTTPS certificate.
# true:  the server already has a web server on 80/443 (e.g. system Caddy/nginx);
#        the app listens on 127.0.0.1:WEB_PORT and the host proxies the domain to it
#        (see deploy/host-caddy.snippet).
BEHIND_HOST_PROXY=false
WEB_PORT=8081

# Database (only reachable inside Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=student_events_db

# Signs login tokens and QR tickets. Changing it logs everyone out and
# invalidates issued QR codes.
SECRET_KEY=CHANGE-ME
TICKET_SECRET=

# First super-admin account, created on the first start only.
ADMIN_EMAIL=admin@ubbcluj.ro
ADMIN_PASSWORD=CHANGE-ME

CHECKIN_OPENS_MINUTES_BEFORE=60
JOBS_INTERVAL_SECONDS=60
# Hours before an event when reminders go out
REMINDER_HOURS=24,3
# Time zone used for dates in notifications and e-mails
APP_TIMEZONE=Europe/Bucharest

# E-mail notifications and tickets (optional). Leave SMTP_HOST empty to keep e-mail off.
# Hetzner blocks outgoing ports 25 and 465 by default: use 587 with STARTTLS.
SMTP_HOST=mail.alexandrupaloti.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=tickets@alexandrupaloti.com
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=UBB Student Events <tickets@alexandrupaloti.com>
