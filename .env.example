# Copy this file to .env and adjust the values (.env is git-ignored).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=student_events_db

# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# Optional separate key for signing QR ticket tokens (derived from SECRET_KEY when empty).
# Changing it invalidates every QR code already issued.
TICKET_SECRET=

# How many minutes before an event starts organizers can begin scanning tickets
CHECKIN_OPENS_MINUTES_BEFORE=60

# Public URL of the frontend. Ticket QR codes link to <FRONTEND_URL>/ticket-check so a
# phone camera opens the ticket page. To test with a phone on your Wi-Fi use
# http://<your-PC-IP>:5173 and start Vite with --host.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Only needed when running the backend locally WITHOUT Docker
# (the Docker setup builds this URL itself and points it at the "db" container)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/student_events_db

# Set to true to print every SQL query
SQL_ECHO=false

# --- Notifications -------------------------------------------------------------
# Background jobs: event reminders and e-mail delivery
BACKGROUND_JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30
# Hours before an event when reminders go out
REMINDER_HOURS=24,3
# Time zone used for dates in notifications and e-mails
APP_TIMEZONE=Europe/Bucharest

# SMTP used for notification e-mails. Empty SMTP_HOST = e-mails disabled
# (in-app notifications still work). Example: SMTP_HOST=smtp.example.com,
# SMTP_PORT=587, SMTP_STARTTLS=true, plus the mailbox credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=UBB Student Events <no-reply@ubb-events.local>
