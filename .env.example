# Copy this file to .env and adjust the values (.env is git-ignored).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=student_events_db

# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# Optional separate key for signing QR ticket tokens (derived from SECRET_KEY when empty).
# Changing it invalidates every QR code already issued.
TICKET_SECRET=

# How many minutes before an event starts organizers can begin scanning tickets
CHECKIN_OPENS_MINUTES_BEFORE=60

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Only needed when running the backend locally WITHOUT Docker
# (the Docker setup builds this URL itself and points it at the "db" container)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/student_events_db

# Set to true to print every SQL query
SQL_ECHO=false
